<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- For parallel runs add: parallel="methods" thread-count="3" (driver is ThreadLocal, so it is safe) -->
<suite name="E-Commerce Automation Suite">
  <listeners>
    <listener class-name="com.ecom.listeners.TestListener"/>
  </listeners>
  <test name="Regression">
    <classes>
      <class name="com.ecom.tests.LoginTest"/>
      <class name="com.ecom.tests.SearchTest"/>
      <class name="com.ecom.tests.CartTest"/>
      <class name="com.ecom.tests.CheckoutTest"/>
    </classes>
  </test>
</suite>
